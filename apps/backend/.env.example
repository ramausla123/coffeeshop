# Copy this file to apps/backend/.env and fill in your real values.
# Never commit apps/backend/.env.

# Runtime
NODE_ENV=production

# Database: Supabase Postgres direct connection
DB_TYPE=postgres

# Option A: paste the Supabase connection string.
# DATABASE_URL=postgresql://postgres:your-database-password@db.your-project-ref.supabase.co:5432/postgres

# Option B: configure the connection parts separately.
DB_HOST=db.your-project-ref.supabase.co
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your-database-password
DB_NAME=postgres
DB_SSL=true

# Set to true only when you intentionally want TypeORM to run compiled migrations on startup.
DB_MIGRATIONS_RUN=false

# Optional local SQLite fallback:
# DB_TYPE=sqlite
# DB_PATH=./coffee.db

# Auth
JWT_SECRET=change-this-secret-to-a-long-random-string

# Midtrans
MIDTRANS_IS_PRODUCTION=false
MIDTRANS_SERVER_KEY=SB-Mid-server-your-key
MIDTRANS_CLIENT_KEY=SB-Mid-client-your-key

# (Optional) default passwords for first-run seeding
DEFAULT_ADMIN_PASSWORD=change-admin-password
DEFAULT_KITCHEN_PASSWORD=change-kitchen-password
DEFAULT_CASHIER_PASSWORD=change-cashier-password
